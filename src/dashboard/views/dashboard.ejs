<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Suzi AI Core | OLED Control Center</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-[#000000] text-[#ededed] font-['Plus_Jakarta_Sans',sans-serif] min-h-screen flex flex-col antialiased selection:bg-violet-600 selection:text-white">
  
  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-3 pointer-events-none"></div>

  <!-- Top Navigation Header -->
  <header class="border-b border-[#161616] bg-[#000000]/90 backdrop-blur-2xl sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <!-- Brand & Bot Status -->
      <div class="flex items-center gap-4">
        <div class="w-11 h-11 bg-gradient-to-tr from-violet-600 via-indigo-600 to-cyan-500 rounded-xl flex items-center justify-center shadow-lg shadow-violet-900/30 ring-1 ring-white/10">
          <i class="fa-solid fa-bolt text-lg text-white"></i>
        </div>
        <div>
          <div class="flex items-center gap-2.5">
            <h1 class="text-base font-bold text-white tracking-tight">Suzi AI Core</h1>
            <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-violet-950/60 text-violet-400 border border-violet-800/40 font-mono">OLED v2.0</span>
          </div>
          <!-- Bot Live Status Pill -->
          <div class="flex items-center gap-2 text-xs mt-0.5">
            <% if (botTelemetry.online) { %>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-950/40 text-emerald-400 border border-emerald-800/40 font-medium text-[11px]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 glow-emerald"></span>
                <span>Online</span>
              </span>
              <span class="text-zinc-600">&bull;</span>
              <span class="text-zinc-400 font-mono text-[11px]"><%= botTelemetry.ping >= 0 ? botTelemetry.ping + 'ms' : '0ms' %></span>
              <span class="text-zinc-600">&bull;</span>
              <span class="text-zinc-400 text-[11px]"><%= botTelemetry.guildCount %> Server<%= botTelemetry.guildCount === 1 ? '' : 's' %></span>
            <% } else { %>
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-rose-950/40 text-rose-400 border border-rose-800/40 font-medium text-[11px]">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                <span>Disconnected</span>
              </span>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Quick Actions & Profile -->
      <div class="flex items-center gap-3">
        <!-- Quick Action: Flush Memory -->
        <button type="button" onclick="openFlushModal()" class="hidden sm:flex items-center gap-2 px-3.5 py-2 bg-[#120508] hover:bg-[#1a070c] text-rose-400 border border-rose-900/40 rounded-xl text-xs font-semibold transition-all hover:border-rose-700/60">
          <i class="fa-solid fa-broom text-rose-500"></i>
          <span>Flush Memory</span>
        </button>

        <!-- Admin Profile -->
        <div class="flex items-center gap-3 pl-3 border-l border-[#1a1a1a]">
          <img src="<%= user.avatarUrl %>" alt="<%= user.username %>" class="w-8 h-8 rounded-full ring-1 ring-violet-500/50">
          <div class="hidden md:block text-left leading-tight">
            <div class="text-xs font-bold text-white"><%= user.username %></div>
            <div class="text-[10px] text-zinc-500 font-mono">Owner / Admin</div>
          </div>
          <a href="/auth/logout" class="p-2 text-zinc-500 hover:text-rose-400 hover:bg-[#111] rounded-lg transition-colors" title="Logout">
            <i class="fa-solid fa-arrow-right-from-bracket text-xs"></i>
          </a>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full space-y-8">
    
    <!-- Flash Messages (Server redirected or query notifications) -->
    <% if (successMessage) { %>
      <div id="server-toast-success" class="oled-card border-emerald-500/50 bg-[#05130b] p-4 rounded-2xl text-emerald-300 text-xs flex items-center justify-between shadow-xl shadow-emerald-950/40">
        <div class="flex items-center gap-3">
          <i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
          <div>
            <div class="font-bold text-white text-xs">Settings Saved</div>
            <div class="text-emerald-400/80 text-[11px]"><%= successMessage %></div>
          </div>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="p-2 text-emerald-400/60 hover:text-emerald-300"><i class="fa-solid fa-xmark"></i></button>
      </div>
    <% } %>
    <% if (errorMessage) { %>
      <div id="server-toast-error" class="oled-card border-rose-500/50 bg-[#180509] p-4 rounded-2xl text-rose-300 text-xs flex items-center justify-between shadow-xl shadow-rose-950/40">
        <div class="flex items-center gap-3">
          <i class="fa-solid fa-triangle-exclamation text-rose-400 text-base"></i>
          <div>
            <div class="font-bold text-white text-xs">Error</div>
            <div class="text-rose-400/80 text-[11px]"><%= errorMessage %></div>
          </div>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="p-2 text-rose-400/60 hover:text-rose-300"><i class="fa-solid fa-xmark"></i></button>
      </div>
    <% } %>

    <!-- Top Telemetry Metric Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      
      <!-- Card 1: Bot Status -->
      <div class="oled-card rounded-2xl p-5 flex items-center justify-between">
        <div>
          <div class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider font-mono">Discord Status</div>
          <div class="text-xl font-bold text-white mt-1 flex items-center gap-2">
            <span><%= botTelemetry.online ? 'Connected' : 'Offline' %></span>
            <% if (botTelemetry.online) { %>
              <span class="w-2 h-2 rounded-full bg-emerald-400 glow-emerald"></span>
            <% } %>
          </div>
          <div class="text-xs text-zinc-400 mt-0.5 font-mono">
            Latency: <span class="text-emerald-400"><%= botTelemetry.ping >= 0 ? botTelemetry.ping : 0 %>ms</span>
          </div>
        </div>
        <div class="w-10 h-10 rounded-xl bg-emerald-950/30 border border-emerald-800/30 flex items-center justify-center text-emerald-400">
          <i class="fa-brands fa-discord text-lg"></i>
        </div>
      </div>

      <!-- Card 2: Context Memory -->
      <div class="oled-card rounded-2xl p-5 flex items-center justify-between">
        <div>
          <div class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider font-mono">Active Memory</div>
          <div id="stat-memory-count" class="text-xl font-bold text-white mt-1 font-mono">
            <%= dbStats.activeMemoryRecords %> Messages
          </div>
          <div class="text-xs text-zinc-400 mt-0.5">
            Auto-wipes on 2h idle
          </div>
        </div>
        <div class="w-10 h-10 rounded-xl bg-violet-950/30 border border-violet-800/30 flex items-center justify-center text-violet-400">
          <i class="fa-solid fa-brain text-lg"></i>
        </div>
      </div>

      <!-- Card 3: Total Logs -->
      <div class="oled-card rounded-2xl p-5 flex items-center justify-between">
        <div>
          <div class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider font-mono">Total Traces</div>
          <div id="stat-logs-count" class="text-xl font-bold text-white mt-1 font-mono">
            <%= dbStats.totalLogs %>
          </div>
          <div class="text-xs text-zinc-400 mt-0.5">
            Logged telemetry events
          </div>
        </div>
        <div class="w-10 h-10 rounded-xl bg-cyan-950/30 border border-cyan-800/30 flex items-center justify-center text-cyan-400">
          <i class="fa-solid fa-chart-line text-lg"></i>
        </div>
      </div>

      <!-- Card 4: Active AI Provider -->
      <div class="oled-card rounded-2xl p-5 flex items-center justify-between">
        <div>
          <div class="text-[11px] font-semibold text-zinc-500 uppercase tracking-wider font-mono">Active Provider</div>
          <div class="text-lg font-bold text-white mt-1 uppercase font-mono tracking-tight text-violet-300">
            <%= settings.provider %>
          </div>
          <div class="text-xs text-zinc-400 mt-0.5 font-mono truncate max-w-[150px]" title="<%= settings.provider === 'gemini' ? settings.gemini_model : settings.openai_model %>">
            <%= settings.provider === 'gemini' ? settings.gemini_model : settings.openai_model %>
          </div>
        </div>
        <div class="w-10 h-10 rounded-xl bg-indigo-950/30 border border-indigo-800/30 flex items-center justify-center text-indigo-400">
          <i class="fa-solid fa-microchip text-lg"></i>
        </div>
      </div>
    </div>

    <!-- MAIN FORM (Supports both AJAX and standard HTML POST submit) -->
    <form id="settings-form" action="/dashboard/settings" method="POST" onsubmit="saveAllSettings(event)" class="space-y-8">
      
      <!-- ========================================================================= -->
      <!-- SECTION 1: FULL SYSTEM PROMPT STUDIO (HERO) -->
      <!-- ========================================================================= -->
      <div class="oled-card rounded-2xl p-6 sm:p-8 relative overflow-hidden border border-violet-900/30">
        <div class="absolute -top-24 -right-24 w-60 h-60 bg-violet-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Studio Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 mb-6 border-b border-[#1a1a1a]">
          <div>
            <div class="flex items-center gap-2.5">
              <span class="w-8 h-8 rounded-lg bg-violet-950/60 border border-violet-800/40 flex items-center justify-center text-violet-400">
                <i class="fa-solid fa-wand-magic-sparkles text-sm"></i>
              </span>
              <h2 class="text-lg font-bold text-white tracking-tight">AI System Prompt Studio</h2>
              <span class="px-2 py-0.5 rounded-md bg-violet-950 text-violet-300 border border-violet-800/40 text-[10px] font-mono font-bold">LIVE AGENT DIRECTIVE</span>
            </div>
            <p class="text-xs text-zinc-400 mt-1">
              This is the <strong>authoritative, complete system prompt</strong> that instructs Suzi. Edit any rule, persona attribute, or behavior.
            </p>
          </div>

          <!-- Quick Presets Bar -->
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-[11px] text-zinc-500 font-mono mr-1">Presets:</span>
            <button type="button" data-persona-preset="default" onclick="applyPersonaPreset('default')" class="px-2.5 py-1 bg-[#111] hover:bg-[#1a1a1a] border border-[#222] text-zinc-300 hover:text-white rounded-lg text-xs font-medium transition-all">
              Suzi (Default)
            </button>
            <button type="button" data-persona-preset="witty" onclick="applyPersonaPreset('witty')" class="px-2.5 py-1 bg-[#111] hover:bg-[#1a1a1a] border border-[#222] text-zinc-300 hover:text-white rounded-lg text-xs font-medium transition-all">
              Witty & Fun
            </button>
            <button type="button" data-persona-preset="developer" onclick="applyPersonaPreset('developer')" class="px-2.5 py-1 bg-[#111] hover:bg-[#1a1a1a] border border-[#222] text-zinc-300 hover:text-white rounded-lg text-xs font-medium transition-all">
              Senior Dev
            </button>
            <button type="button" data-persona-preset="minimalist" onclick="applyPersonaPreset('minimalist')" class="px-2.5 py-1 bg-[#111] hover:bg-[#1a1a1a] border border-[#222] text-zinc-300 hover:text-white rounded-lg text-xs font-medium transition-all">
              Minimalist
            </button>
            <button type="button" id="btn-reset-prompt" onclick="resetPromptToDefault()" class="p-1.5 text-zinc-500 hover:text-rose-400 transition-colors ml-1" title="Reset to Suzi Default">
              <i class="fa-solid fa-arrow-rotate-left text-xs"></i>
            </button>
          </div>
        </div>

        <!-- Editor Container -->
        <div class="space-y-3">
          <div class="flex items-center justify-between text-xs text-zinc-500 font-mono">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-code text-violet-400"></i> system_instruction (full prompt text)</span>
            <span id="prompt-counter" class="text-zinc-400">0 chars | 0 words (~0 tokens)</span>
          </div>

          <textarea 
            id="system_instruction" 
            name="system_instruction" 
            rows="10" 
            class="w-full prompt-editor rounded-xl p-4 text-xs sm:text-sm text-zinc-100 resize-y"
            placeholder="Write the complete system prompt instructions here..."
          ><%= settings.system_instruction || defaultSystemPrompt %></textarea>

          <div class="flex items-center justify-between text-[11px] text-zinc-500 pt-1">
            <span>💡 <em>Tip: Changes take effect on the very next message in Discord with zero downtime.</em></span>
            <button 
              type="submit" 
              id="btn-save-prompt"
              class="px-4 py-2 bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white rounded-xl text-xs font-bold shadow-lg shadow-violet-950/50 transition-all flex items-center gap-2"
            >
              <i class="fa-solid fa-check"></i>
              <span>Save System Prompt</span>
            </button>
          </div>
        </div>
      </div>

      <!-- ========================================================================= -->
      <!-- SECTION 2: AI PROVIDER & MODEL STUDIO -->
      <!-- ========================================================================= -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- Left 2 Cols: Provider, Keys, Model & Test Tool -->
        <div class="lg:col-span-2 oled-card rounded-2xl p-6 sm:p-8 space-y-6">
          <div class="flex items-center justify-between pb-4 border-b border-[#1a1a1a]">
            <div>
              <h2 class="text-base font-bold text-white flex items-center gap-2">
                <i class="fa-solid fa-sliders text-cyan-400"></i>
                AI Engine & Provider Configuration
              </h2>
              <p class="text-xs text-zinc-400 mt-0.5">Switch between OpenAI-compatible endpoints or Google Gemini.</p>
            </div>

            <!-- Provider Pill Tabs -->
            <div class="flex bg-[#050505] p-1 rounded-xl border border-[#1a1a1a]">
              <input type="hidden" name="provider" id="provider-input" value="<%= settings.provider %>">
              <button 
                type="button" 
                id="tab-openai"
                data-provider-tab="openai"
                onclick="toggleProviderUI('openai')" 
                class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all <%= settings.provider === 'openai' ? 'bg-white text-black' : 'text-slate-400 hover:text-white' %>"
              >
                OpenAI / NVIDIA / Groq
              </button>
              <button 
                type="button" 
                id="tab-gemini"
                data-provider-tab="gemini"
                onclick="toggleProviderUI('gemini')" 
                class="px-3 py-1.5 rounded-lg text-xs font-bold transition-all <%= settings.provider === 'gemini' ? 'bg-white text-black' : 'text-slate-400 hover:text-white' %>"
              >
                Google Gemini
              </button>
            </div>
          </div>

          <!-- OPENAI-COMPATIBLE FIELDS -->
          <div id="openai-fields" class="space-y-4 <%= settings.provider === 'gemini' ? 'hidden' : '' %>">
            <!-- Preset Buttons -->
            <div>
              <label class="block text-xs font-semibold text-zinc-400 mb-2">Endpoint Quick Presets:</label>
              <div class="flex items-center gap-2 flex-wrap">
                <button type="button" data-endpoint-preset="nvidia" onclick="applyPreset('nvidia')" class="px-3 py-1.5 rounded-lg bg-[#111] hover:bg-[#1a1a1a] border border-[#222] text-xs font-mono font-medium text-emerald-300 hover:border-emerald-700/50 transition-all flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-400"></span> NVIDIA NIM
                </button>
                <button type="button" data-endpoint-preset="groq" onclick="applyPreset('groq')" class="px-3 py-1.5 rounded-lg bg-[#111] hover:bg-[#1a1a1a] border border-[#222] text-xs font-mono font-medium text-amber-300 hover:border-amber-700/50 transition-all">
                  Groq (Fast)
                </button>
                <button type="button" data-endpoint-preset="openai" onclick="applyPreset('openai')" class="px-3 py-1.5 rounded-lg bg-[#111] hover:bg-[#1a1a1a] border border-[#222] text-xs font-mono font-medium text-cyan-300 hover:border-cyan-700/50 transition-all">
                  OpenAI
                </button>
                <button type="button" data-endpoint-preset="deepseek" onclick="applyPreset('deepseek')" class="px-3 py-1.5 rounded-lg bg-[#111] hover:bg-[#1a1a1a] border border-[#222] text-xs font-mono font-medium text-indigo-300 hover:border-indigo-700/50 transition-all">
                  DeepSeek
                </button>
                <button type="button" data-endpoint-preset="openrouter" onclick="applyPreset('openrouter')" class="px-3 py-1.5 rounded-lg bg-[#111] hover:bg-[#1a1a1a] border border-[#222] text-xs font-mono font-medium text-purple-300 hover:border-purple-700/50 transition-all">
                  OpenRouter
                </button>
              </div>
            </div>

            <!-- Base URL & Model Name -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-zinc-300 mb-1.5">Base URL</label>
                <input 
                  type="text" 
                  id="openai_base_url" 
                  name="openai_base_url" 
                  value="<%= settings.openai_base_url || 'https://integrate.api.nvidia.com/v1' %>" 
                  placeholder="https://integrate.api.nvidia.com/v1" 
                  class="w-full oled-input rounded-xl px-4 py-2.5 text-xs font-mono"
                >
              </div>

              <div>
                <label class="block text-xs font-bold text-zinc-300 mb-1.5">Model Name</label>
                <input 
                  type="text" 
                  id="openai_model" 
                  name="openai_model" 
                  value="<%= settings.openai_model || 'meta/llama-3.2-11b-vision-instruct' %>" 
                  placeholder="meta/llama-3.2-11b-vision-instruct" 
                  class="w-full oled-input rounded-xl px-4 py-2.5 text-xs font-mono"
                >
              </div>
            </div>

            <!-- API Key Input -->
            <div>
              <label class="block text-xs font-bold text-zinc-300 mb-1.5">API Key</label>
              <div class="relative">
                <input 
                  type="password" 
                  id="openai_api_key" 
                  name="openai_api_key" 
                  value="<%= settings.openai_api_key || '' %>" 
                  placeholder="nvapi-... or sk-..." 
                  class="w-full oled-input rounded-xl pl-4 pr-10 py-2.5 text-xs font-mono"
                >
                <button 
                  type="button" 
                  onclick="togglePasswordVisibility('openai_api_key')" 
                  class="absolute right-3 top-2.5 text-zinc-500 hover:text-zinc-300"
                >
                  <i class="fa-solid fa-eye text-xs"></i>
                </button>
              </div>
            </div>
          </div>

          <!-- GEMINI FIELDS -->
          <div id="gemini-fields" class="space-y-4 <%= settings.provider === 'gemini' ? '' : 'hidden' %>">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-zinc-300 mb-1.5">Gemini Model</label>
                <select 
                  id="gemini_model" 
                  name="gemini_model" 
                  class="w-full oled-input rounded-xl px-4 py-2.5 text-xs font-mono"
                >
                  <option value="gemini-1.5-flash-latest" <%= settings.gemini_model === 'gemini-1.5-flash-latest' ? 'selected' : '' %>>gemini-1.5-flash-latest (Fastest)</option>
                  <option value="gemini-1.5-flash" <%= settings.gemini_model === 'gemini-1.5-flash' ? 'selected' : '' %>>gemini-1.5-flash</option>
                  <option value="gemini-2.0-flash" <%= settings.gemini_model === 'gemini-2.0-flash' ? 'selected' : '' %>>gemini-2.0-flash</option>
                  <option value="gemini-1.5-pro-latest" <%= settings.gemini_model === 'gemini-1.5-pro-latest' ? 'selected' : '' %>>gemini-1.5-pro-latest (Smartest)</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-zinc-300 mb-1.5">Google Gemini API Key</label>
                <div class="relative">
                  <input 
                    type="password" 
                    id="gemini_api_key" 
                    name="gemini_api_key" 
                    value="<%= settings.gemini_api_key || '' %>" 
                    placeholder="AIzaSy..." 
                    class="w-full oled-input rounded-xl pl-4 pr-10 py-2.5 text-xs font-mono"
                  >
                  <button 
                    type="button" 
                    onclick="togglePasswordVisibility('gemini_api_key')" 
                    class="absolute right-3 top-2.5 text-zinc-500 hover:text-zinc-300"
                  >
                    <i class="fa-solid fa-eye text-xs"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- LIVE TEST CONNECTION TOOL -->
          <div class="pt-4 border-t border-[#1a1a1a]">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-bold text-white flex items-center gap-1.5">
                  <i class="fa-solid fa-stethoscope text-emerald-400"></i> AI Connection Diagnostic
                </span>
                <p class="text-[11px] text-zinc-500">Test if your credentials and model respond without switching to Discord.</p>
              </div>

              <button 
                type="button" 
                id="btn-test-ai" 
                onclick="testAiConnection()" 
                class="px-3.5 py-2 bg-[#121212] hover:bg-[#1a1a1a] border border-[#2a2a2a] text-white rounded-xl text-xs font-bold transition-all flex items-center gap-2 hover:border-emerald-500/50"
              >
                <i class="fa-solid fa-play text-emerald-400 text-xs"></i>
                <span>Test Connection</span>
              </button>
            </div>

            <!-- Dynamic Result Card -->
            <div id="test-ai-result" class="hidden mt-3 p-4 rounded-xl border">
              <div id="test-ai-meta" class="mb-1 text-xs"></div>
              <div id="test-ai-output" class="font-mono text-zinc-300 text-xs whitespace-pre-wrap"></div>
            </div>
          </div>

          <!-- Parameters: Temperature & Max Tokens -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-4 border-t border-[#1a1a1a]">
            <div>
              <div class="flex items-center justify-between text-xs font-bold text-zinc-300 mb-2">
                <span>Creativity (Temperature)</span>
                <span id="temp-val" class="text-violet-400 font-mono font-bold"><%= settings.temperature || 0.7 %></span>
              </div>
              <input 
                type="range" 
                name="temperature" 
                min="0.0" 
                max="1.0" 
                step="0.05" 
                value="<%= settings.temperature || 0.7 %>" 
                oninput="document.getElementById('temp-val').innerText = this.value" 
                class="w-full cursor-pointer"
              >
              <div class="flex justify-between text-[10px] text-zinc-500 mt-1 font-mono">
                <span>0.0 (Precise)</span>
                <span>1.0 (Creative)</span>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-zinc-300 mb-1.5">Max Output Tokens</label>
              <input 
                type="number" 
                name="max_tokens" 
                min="100" 
                max="4000" 
                step="50" 
                value="<%= settings.max_tokens || 1000 %>" 
                class="w-full oled-input rounded-xl px-4 py-2 text-xs font-mono"
              >
              <p class="text-[10px] text-zinc-500 mt-1">Prevents runaway token usage.</p>
            </div>
          </div>
        </div>

        <!-- Right 1 Col: Channel Routing & Tools Setup -->
        <div class="space-y-6">
          
          <!-- Auto-Chat Channel Selection -->
          <div class="oled-card rounded-2xl p-6 space-y-4">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider font-mono flex items-center gap-2 pb-3 border-b border-[#1a1a1a]">
              <i class="fa-solid fa-hashtag text-cyan-400"></i> Auto-Chat Channel
            </h3>
            
            <p class="text-xs text-zinc-400 leading-relaxed">
              In this channel, Suzi replies automatically to <strong>every message</strong> without needing a mention or tag.
            </p>

            <div>
              <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Select Channel:</label>
              <% if (channels && channels.length > 0) { %>
                <select 
                  id="channel-select" 
                  onchange="document.getElementById('auto_channel_id').value = this.value" 
                  class="w-full oled-input rounded-xl px-3 py-2 text-xs mb-2"
                >
                  <option value="">-- No Auto Channel (Mention Only) --</option>
                  <% channels.forEach(ch => { %>
                    <option value="<%= ch.id %>" <%= settings.auto_channel_id === ch.id ? 'selected' : '' %>>
                      #<%= ch.name %> (<%= ch.guildName %>)
                    </option>
                  <% }) %>
                </select>
              <% } %>

              <label class="block text-[11px] text-zinc-500 mb-1">Or enter Channel ID manually:</label>
              <input 
                type="text" 
                id="auto_channel_id" 
                name="auto_channel_id" 
                value="<%= settings.auto_channel_id || '' %>" 
                placeholder="e.g. 1159753832369229885" 
                class="w-full oled-input rounded-xl px-3 py-2 text-xs font-mono"
              >
            </div>
          </div>

          <!-- Web Search & Scrape Tool Keys -->
          <div class="oled-card rounded-2xl p-6 space-y-4">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider font-mono flex items-center gap-2 pb-3 border-b border-[#1a1a1a]">
              <i class="fa-solid fa-magnifying-glass text-violet-400"></i> Tool Credentials
            </h3>

            <p class="text-xs text-zinc-400 leading-relaxed">
              Tools are explicitly invoked with <strong>`/search`</strong> and <strong>`/scrape`</strong>.
            </p>

            <div class="space-y-3">
              <div>
                <label class="block text-xs font-semibold text-zinc-300 mb-1">Tavily API Key (Web Search)</label>
                <input 
                  type="password" 
                  name="tavily_api_key" 
                  value="<%= settings.tavily_api_key || '' %>" 
                  placeholder="tvly-..." 
                  class="w-full oled-input rounded-xl px-3 py-2 text-xs font-mono"
                >
              </div>

              <div>
                <label class="block text-xs font-semibold text-zinc-300 mb-1">Firecrawl API Key (Web Scraper)</label>
                <input 
                  type="password" 
                  name="firecrawl_api_key" 
                  value="<%= settings.firecrawl_api_key || '' %>" 
                  placeholder="fc-..." 
                  class="w-full oled-input rounded-xl px-3 py-2 text-xs font-mono"
                >
              </div>
            </div>
          </div>

          <!-- Master Save Button -->
          <button 
            type="submit" 
            id="btn-save-settings" 
            class="w-full py-3.5 bg-gradient-to-r from-violet-600 via-indigo-600 to-cyan-600 hover:opacity-95 text-white font-bold rounded-2xl text-xs shadow-xl shadow-violet-950/60 transition-all flex items-center justify-center gap-2"
          >
            <i class="fa-solid fa-floppy-disk text-sm"></i>
            <span>Save All Changes</span>
          </button>
        </div>
      </div>
    </form>

    <!-- ========================================================================= -->
    <!-- SECTION 3: LIVE ACTIVITY TELEMETRY & TRACE FEED -->
    <!-- ========================================================================= -->
    <div class="oled-card rounded-2xl p-6 sm:p-8 space-y-4">
      <div class="flex items-center justify-between pb-4 border-b border-[#1a1a1a]">
        <div>
          <h2 class="text-base font-bold text-white flex items-center gap-2">
            <i class="fa-solid fa-terminal text-emerald-400"></i>
            Live Activity & Telemetry Feed
          </h2>
          <p class="text-xs text-zinc-400 mt-0.5">Real-time trace logs of messages, AI tokens, latencies, and tool dispatches.</p>
        </div>

        <button 
          type="button" 
          onclick="refreshActivityLogs()" 
          class="px-3 py-1.5 bg-[#111] hover:bg-[#1a1a1a] border border-[#222] text-zinc-300 hover:text-white rounded-lg text-xs font-medium transition-all flex items-center gap-1.5"
        >
          <i class="fa-solid fa-arrows-rotate text-xs"></i>
          <span>Refresh</span>
        </button>
      </div>

      <div class="overflow-x-auto rounded-xl border border-[#141414]">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-[#050505] border-b border-[#141414] text-[11px] font-mono text-zinc-500 uppercase tracking-wider">
              <th class="px-4 py-3">Time</th>
              <th class="px-4 py-3">User</th>
              <th class="px-4 py-3">Model</th>
              <th class="px-4 py-3">Tokens</th>
              <th class="px-4 py-3">Latency</th>
              <th class="px-4 py-3 text-right">Details</th>
            </tr>
          </thead>
          <tbody id="activity-logs-tbody" class="divide-y divide-[#101010] bg-[#020202]">
            <% if (!logs || logs.length === 0) { %>
              <tr>
                <td colspan="6" class="px-4 py-8 text-center text-zinc-600 font-mono text-xs">
                  No activity logs recorded yet. Send a message in Discord to start logging!
                </td>
              </tr>
            <% } else { %>
              <% logs.forEach(log => { %>
                <tr class="hover:bg-[#0c0c0c] transition-colors">
                  <td class="px-4 py-3 font-mono text-zinc-400 whitespace-nowrap text-xs">
                    <%= new Date(log.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
                  </td>
                  <td class="px-4 py-3 font-medium text-white whitespace-nowrap text-xs">
                    <span class="text-violet-400">@<%= log.user_tag || log.user_id || 'User' %></span>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-mono <%= log.provider === 'gemini' ? 'bg-violet-950/40 text-violet-300 border border-violet-800/40' : 'bg-cyan-950/40 text-cyan-300 border border-cyan-800/40' %>">
                      <%= log.model || log.provider %>
                    </span>
                  </td>
                  <td class="px-4 py-3 font-mono text-zinc-300 whitespace-nowrap text-xs"><%= log.tokens_used || 0 %></td>
                  <td class="px-4 py-3 font-mono whitespace-nowrap text-xs">
                    <span class="<%= (log.latency_ms || 0) > 3000 ? 'text-amber-400' : 'text-emerald-400' %>">
                      <%= log.latency_ms || 0 %>ms
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right whitespace-nowrap">
                    <button type="button" onclick="toggleLogDetail('<%= log.id %>')" class="text-violet-400 hover:text-violet-300 font-semibold text-xs transition-colors">
                      View Trace <i class="fa-solid fa-chevron-down text-[10px] ml-1"></i>
                    </button>
                  </td>
                </tr>
                <tr id="log-detail-<%= log.id %>" class="hidden bg-[#000000]">
                  <td colspan="6" class="p-4 border-b border-[#1a1a1a]">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                      <div>
                        <div class="font-bold text-zinc-400 mb-1 flex items-center gap-1.5 font-mono text-[11px]">
                          <i class="fa-solid fa-user text-violet-400"></i> User Prompt:
                        </div>
                        <div class="bg-[#050505] p-3 rounded-xl border border-[#1a1a1a] text-zinc-200 font-mono text-[11px] whitespace-pre-wrap max-h-40 overflow-y-auto"><%= log.prompt || '' %></div>
                      </div>
                      <div>
                        <div class="font-bold text-zinc-400 mb-1 flex items-center gap-1.5 font-mono text-[11px]">
                          <i class="fa-solid fa-robot text-emerald-400"></i> AI Response:
                        </div>
                        <div class="bg-[#050505] p-3 rounded-xl border border-[#1a1a1a] text-zinc-200 font-mono text-[11px] whitespace-pre-wrap max-h-40 overflow-y-auto"><%= log.reply || '' %></div>
                      </div>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>

  <!-- FLUSH MEMORY CONFIRMATION MODAL -->
  <div id="flush-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
    <div class="oled-card rounded-2xl max-w-md w-full p-6 border border-rose-900/40 shadow-2xl shadow-rose-950/50 space-y-4">
      <div class="flex items-center gap-3 text-rose-400">
        <span class="w-10 h-10 rounded-xl bg-rose-950/40 border border-rose-800/40 flex items-center justify-center text-lg">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </span>
        <div>
          <h3 class="text-sm font-bold text-white">Flush All Conversation Memory?</h3>
          <p class="text-[11px] text-zinc-400">This action cannot be undone.</p>
        </div>
      </div>

      <p class="text-xs text-zinc-300 leading-relaxed">
        This will instantly delete all stored Discord conversation history across all channels from Supabase. Suzi will forget recent messages and start fresh.
      </p>

      <div class="flex items-center justify-end gap-2 pt-2 border-t border-[#1a1a1a]">
        <button type="button" onclick="closeFlushModal()" class="px-4 py-2 rounded-xl bg-[#111] hover:bg-[#1a1a1a] text-zinc-300 text-xs font-semibold">
          Cancel
        </button>
        <button type="button" onclick="executeFlushAll()" class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold shadow-lg shadow-rose-950/50">
          Yes, Flush Memory
        </button>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer class="border-t border-[#141414] py-6 text-center text-xs text-zinc-600 font-mono">
    Suzi Discord AI Core &bull; Pure OLED Black Architecture &bull; MIT License
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
