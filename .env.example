# ==============================================================================
# DISCORD BOT & WEB DASHBOARD CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DISCORD APPLICATION CREDENTIALS
# ------------------------------------------------------------------------------
# Get these from https://discord.com/developers/applications
DISCORD_BOT_TOKEN="your_discord_bot_token_here"
DISCORD_CLIENT_ID="your_discord_client_id_here"
DISCORD_CLIENT_SECRET="your_discord_client_secret_here"

# Comma-separated list of Discord User IDs with dashboard admin access.
# Enable Developer Mode in Discord settings, right-click your profile -> "Copy User ID".
ADMIN_USER_IDS="123456789012345678,987654321098765432"

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Get these from Supabase Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_or_anon_key_here"

# ------------------------------------------------------------------------------
# 3. WEB DASHBOARD & EXPRESS SERVER
# ------------------------------------------------------------------------------
PORT=3000
# For local dev: http://localhost:3000
# For Render deployment: https://your-service-name.onrender.com (without trailing slash)
APP_URL="http://localhost:3000"
SESSION_SECRET="change_this_to_a_super_secure_random_string_in_production"

# ------------------------------------------------------------------------------
# 4. INITIAL BOT CONFIGURATION (Can also be managed live in Dashboard)
# ------------------------------------------------------------------------------
# Dedicated Auto-Chat Channel ID (Bot automatically replies without @mention here)
AUTO_CHANNEL_ID="123456789012345678"

# Default AI Provider ('gemini' or 'openai')
AI_PROVIDER="gemini"

# Google Gemini Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-1.5-flash"

# OpenAI / Groq / OpenRouter / DeepSeek Configuration
OPENAI_API_KEY="your_openai_or_groq_or_openrouter_api_key_here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"
# Examples for other providers:
# Groq: https://api.groq.com/openai/v1 (Model: llama-3.3-70b-versatile)
# OpenRouter: https://openrouter.ai/api/v1 (Model: deepseek/deepseek-chat)
# DeepSeek: https://api.deepseek.com/v1 (Model: deepseek-chat)
# NVIDIA NIM: https://integrate.api.nvidia.com/v1 (Model: meta/llama-3.1-8b-instruct)

# ------------------------------------------------------------------------------
# 5. REAL-TIME WEB SEARCH TOOL (Optional)
# ------------------------------------------------------------------------------
ENABLE_WEB_SEARCH=true
# Optional: Tavily API Key (from https://tavily.com - 1000 free searches/mo)
TAVILY_API_KEY=""
# Optional: Firecrawl API Key (from https://firecrawl.dev - for live web scraping)
FIRECRAWL_API_KEY=""
